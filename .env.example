# All variables are optional. Copy this file to .env for local development
# (only picked up by `go run -tags dev`, see README.md) — a release binary
# only ever reads real OS/systemd environment variables.

# Listen addresses for the two servers. Defaults shown.
CLENS_PROXY_ADDR=:7801
CLENS_ADMIN_ADDR=:7802

# Where the SQLite DB and log file are written. Defaults shown — relative
# to the working directory the binary is run from. Set these to absolute
# paths if running from an arbitrary CWD (e.g. under systemd).
CLENS_DATA_DIR=data
CLENS_LOG_DIR=logs
